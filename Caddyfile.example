# Production configuration for KoalaFi
:80 {
	root * /srv
	file_server

	# Gzip and Zstandard compression
	encode zstd gzip

	# SPA Fallback for client-side routing
	try_files {path} /index.html

	# Security Headers
	header {
		# Clickjacking defense
		X-Frame-Options "DENY"

		# MIME sniffing defense
		X-Content-Type-Options "nosniff"

		# Referrer integrity
		Referrer-Policy "strict-origin-when-cross-origin"

		# SvelteKit emits the resource-loading CSP with per-build script hashes.
		# This header adds policies that cannot be enforced by a prerendered CSP meta tag.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self';"

		# Isolate the app without requiring cross-origin resource embedding.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# KoalaFi never requests device sensors, payments, or capture devices.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# Service Worker: Do NOT cache long-term to ensure immediate updates
	@serviceWorker {
		path /service-worker.js
	}
	header @serviceWorker Cache-Control "public, max-age=0, must-revalidate"

	@pwaMetadata {
		path /manifest.webmanifest /robots.txt
	}
	header @pwaMetadata Cache-Control "public, max-age=0, must-revalidate"

	# Hashed Assets: Cache forever (1 year)
	@hashedAssets {
		path /_app/*
	}
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
}
